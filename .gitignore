# Never commit live data — contains Discord message IDs, kill timers, and parse history
data/state.json
data/state.json.tmp
data/parses.json
data/parses.json.tmp
data/historical_chat.jsonl

# Environment
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Raid tick exports
raid-tick-*.txt

# Logs
*.log
npm-debug.log*
# …except the #75 golden-log fixtures, which are SYNTHETIC (hand-written,
# invented names — never a real player log; see docs/PRIVACY.md) and must be
# committed for the parser regression net to mean anything.
!test/fixtures/golden/*.log
package-lock.json
dist/
packages/wolfpack-logsync/logsync.stats.json
# A user's own imported/authored triggers — local state that happens to live
# in the package dir (STATS_FILE anchors it there). Never commit someone's set.
packages/wolfpack-logsync/personal_triggers.json
packages/wolfpack-logsync/logsync.queue.json
packages/wolfpack-logsync/logsync.item-catalog.json
packages/wolfpack-logsync/logsync.optin.json
packages/wolfpack-logsync/logsync.session.json
packages/wolfpack-logsync/logsync.pid.json
# Durable upload queue + pet/buff state. Same machine-local runtime class as the
# four above, but they were missing from this list — so merely REQUIRING the
# agent (a test, a repl, a probe script) drops them in the working tree and they
# show up as untracked. They carry real guild data (queued trigger fires with
# raider names, observed buff landings), so they must never be committed.
packages/wolfpack-logsync/logsync.queue.json
packages/wolfpack-logsync/logsync.item-catalog.json
packages/wolfpack-logsync/logsync.pet-state.json
# Loot-bidding local state. `beta` has ignored these since agent 3.3.100 and
# main never picked them up — the entries were added on the branch the feature
# was built on and no graduation carried a .gitignore. logsync.opendkp.json is
# the serious one: it holds an OpenDKP BEARER TOKEN. Nothing has leaked (none
# were ever tracked), but the code that writes all four now ships from main.
packages/wolfpack-logsync/logsync.opendkp.json
packages/wolfpack-logsync/logsync.bidfamily.json
packages/wolfpack-logsync/logsync.plannedbids.json
packages/wolfpack-logsync/logsync.lootdismiss.json
packages/wolfpack-logsync/.last-update-check
packages/wolfpack-logsync/.force-update-on-restart
packages/wolfpack-logsync/.update-token-on-restart

# Gemini research helper (local dev aid) — keys + generated images, never commit
.env.research.local
gemini-image-*.png

# Agent-tool git worktrees (transient per-session workspaces for subagents)
.claude/worktrees/

# Impeccable review captures and generated comps — evidence for a review round,
# not source. The findings live in the commit message and DESIGN.md.
.impeccable/review/
.impeccable/mocks/
