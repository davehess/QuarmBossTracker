    ],
    "views": [
      {
        "id": "privacy",
        "label": "What never leaves",
        "focus": [
          "logfile",
          "filter",
          "dropped",
          "trackers"
        ],
        "note": "The filter runs on raw bytes before the parser sees a line, so private channels are discarded rather than parsed and withheld."
      },
      {
        "id": "local",
        "label": "What you see instantly",
        "focus": [
          "pipe",
          "trackers",
          "overlays"
        ],
        "note": "Overlays render off local trackers with no round trip. Nothing you see about your own client depends on the network."
      },
      {
        "id": "shared",
        "label": "What the guild sees",
        "focus": [
          "queue",
          "bot",
          "db",
          "discord"
        ],
        "note": "Shareable events go through a durable queue that survives restarts, then merge with every other raider's view of the same fight."
      }
    ]
  },
