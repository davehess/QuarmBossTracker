+  const Point center = {0, 1.256f};  // Puts the lowest corners at the bottom.
+  return {{Bar(center, 3.0f, 0.55f, kPi / 4), center}, {Bar(center, 3.0f, 0.55f, -kPi / 4), center}};
+}
+
+std::vector<Part> SwordParts() {
