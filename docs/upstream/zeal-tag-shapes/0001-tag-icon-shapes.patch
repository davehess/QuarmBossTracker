+  for (float z : {0.22f, 1.3f}) parts.push_back(Flat(Rect(-0.6f, z, 0.6f, z + 0.13f), Tone::Dark, 1));
+  parts.push_back(Flat(Rect(-0.64f, 1.62f, 0.64f, 1.82f), Tone::Light, 1));  // Foam.
