+std::vector<Part> TowerParts() {  // Sentinels: a watchtower.
+  std::vector<Part> parts;
+  parts.push_back(Flat({{-0.6f, 0}, {0.6f, 0}, {0.5f, 1.9f}, {-0.5f, 1.9f}}, Tone::Base, 0));
