+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+// Geometry for the icon-style tag shapes (skull, cross, sword, diamond, flame, star).
+//
+// Each shape is a set of flat parts extruded to a thickness, and every part is convex (or at least
+// star-shaped around its center) so it triangulates as a simple fan. Concave outlines are built by
+// overlapping parts, and detail such as eye sockets or a blade's fuller is a part that stands slightly
+// proud of both faces in an accent tone, so no texture or concave triangulation is needed.
+//
+// This is plain math with no DirectX dependency so the meshes can be checked and previewed off-client.
+namespace TagShapes {
+
+enum class Kind {
+  Skull = 0,
+  Cross,
+  Sword,
+  Diamond,
+  Flame,
+  Star,
+  Count,  // Number of shapes (not a shape).
+};
+
+// Which color a vertex takes: the tag color, a dark accent, or a light accent.
+enum class Tone : uint8_t {
+  Base = 0,
+  Dark,
+  Light,
+};
+
+struct Vertex {
+  float x;  // Model space: x runs across the face,
+  float y;  // y through its thickness (negative is the front face),
+  float z;  // and z up, with the bottom of the shape at 0.
+  Tone tone;
+};
+
+struct Mesh {
+  std::vector<Vertex> vertices;
+  std::vector<int16_t> indices;  // A single triangle strip; degenerate triangles join the parts.
+  float min_z = 0;
+  float max_z = 0;
+};
+
+// Returns the mesh for a shape (empty for Kind::Count).
+Mesh Build(Kind kind);
+
+}  // namespace TagShapes
