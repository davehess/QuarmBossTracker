diff --git a/Zeal/target_pet.cpp b/Zeal/target_pet.cpp
new file mode 100644
index 0000000..e639fde
--- /dev/null
+++ b/Zeal/target_pet.cpp
@@ -0,0 +1,42 @@
+#include "target_pet.h"
+
+#include <string>
+#include <vector>
+
+#include "commands.h"
+#include "game_functions.h"
+#include "zeal.h"
+
+namespace {
+
+// Targets the player's own pet. Always says something when it cannot, and never changes the target in that case.
+bool target_pet(std::vector<std::string> &args) {
+  if (args.size() > 1) {
+    Zeal::Game::print_chat("Usage: /targetpet");
+    return true;
+  }
+  if (!Zeal::Game::is_in_game()) return true;
+
+  // ActorInfo::PetID is the pet's spawn id, but it is a SHORT that holds -1 (not 0) when there is no pet.
+  const auto *self = Zeal::Game::get_self();
+  const int pet_id = (self && self->ActorInfo) ? self->ActorInfo->PetID : -1;
+  if (pet_id <= 0) {
+    Zeal::Game::print_chat("You do not have a pet to target.");
+    return true;
+  }
+
+  auto *pet = Zeal::Game::get_entity_by_id(pet_id);  // Rejects ids outside the spawn table, so null means "not here".
+  if (!pet) {
+    Zeal::Game::print_chat("Your pet could not be found (out of range or zoning).");
+    return true;
+  }
+
+  if (pet != Zeal::Game::get_target()) Zeal::Game::set_target(pet);  // Already on target: nothing to do.
+  return true;
+}
+
+}  // namespace
+
+TargetPet::TargetPet(ZealService *zeal) {
+  zeal->commands_hook->Add("/targetpet", {}, "Targets your own pet (works for a charmed pet too).", target_pet);
+}
diff --git a/Zeal/target_pet.h b/Zeal/target_pet.h
new file mode 100644
index 0000000..ee44ae9
--- /dev/null
+++ b/Zeal/target_pet.h
@@ -0,0 +1,14 @@
+#pragma once
+
+// Adds /targetpet: target your own pet from a hotkey or a social button, so a pet class does not need to click the
+// pet window mid-fight. A charmed pet is a pet like any other (the client fills the same pet id), so a bard,
+// enchanter or necromancer can put it on target from the keyboard.
+class TargetPet {
+ public:
+  explicit TargetPet(class ZealService *zeal);
+  ~TargetPet() = default;
+
+  // Disable copy.
+  TargetPet(TargetPet const &) = delete;
+  TargetPet &operator=(TargetPet const &) = delete;
+};
