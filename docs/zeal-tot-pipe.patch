+        auto emit = [&](const char *key, const AssistTarget::Candidate &c) {
+          if (!c.id) return;
+          nlohmann::json j = nlohmann::json::object();
+          j["id"] = c.id;
+          if (const auto *e = AssistTarget::LookupLiveEntity(c.id)) j["name"] = e->Name;
+          j["authoritative"] = c.authoritative;
+          player_data[key] = j;
+        };
+        emit("target_of_target", assist_target->ResolveCandidate(target->SpawnId, now, false, true));
+        emit("target_hit_by", assist_target->ResolveCandidate(target->SpawnId, now, true, false));
