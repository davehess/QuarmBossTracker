+      //   target_of_target - who the target last hit (assist semantics)
+      //   target_hit_by    - who last hit the target (defend semantics)
+      // Each is {id, name, authoritative}; `name` is omitted when the entity is
+      // gone or a corpse, and the whole key is omitted when there is no fresh
+      // candidate, like target_id / pet_id above.
+      const auto *assist_target = ZealService::get_instance()->assist_target.get();
