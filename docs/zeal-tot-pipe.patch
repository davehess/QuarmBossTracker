+bool AssistTarget::IsActive() const {
+  if (setting_enabled.get()) return true;
+  const auto *zeal = ZealService::get_instance();
+  return zeal && zeal->pipe && zeal->pipe->is_connected();
+}
+
+Zeal::GameStructures::Entity *AssistTarget::LookupLiveEntity(WORD id) {
+  if (!id) return nullptr;
+  auto entity = Zeal::Game::get_entity_by_id(id);
+  if (entity && (entity->StructType != 0x03 || entity->Type == Zeal::GameEnums::NPCCorpse ||
+                 entity->Type == Zeal::GameEnums::PlayerCorpse))
+    return nullptr;
+  return entity;
+}
+
+AssistTarget::Candidate AssistTarget::ResolveCandidate(WORD target_id, DWORD now, bool defend,
+                                                       bool use_assist_reply) const {
+  Candidate out;
+  if (!target_id) return out;
+  const DWORD window = static_cast<DWORD>(setting_window_ms.get());
+  DWORD candidate_ts = 0;
+
+  // Source A: damage inference (who the target last hit / who last hit the target).
+  const auto &map = defend ? hit_by : victim_of;
+  auto it = map.find(target_id);
+  if (it != map.end()) {
+    const DWORD age = now - it->second.timestamp_ms;
+    if (age <= window && it->second.timestamp_ms > candidate_ts) {
+      out.id = it->second.other_id;
+      out.authoritative = false;
+      candidate_ts = it->second.timestamp_ms;
+    }
+  }
+
+  // Source B: authoritative OP_Assist response. Fresh for the damage window, or longer when
+  // auto-refresh is on so the bar stays up between polls.
+  if (use_assist_reply && assist_response_time != 0) {
+    const DWORD assist_window = setting_auto_refresh.get()
+                                    ? std::max(window, static_cast<DWORD>(setting_refresh_interval_ms.get()) + 5000)
+                                    : window;
+    const DWORD age = now - assist_response_time;
+    if (age <= assist_window && assist_response_time > candidate_ts) {
+      out.id = assist_response_id;
+      out.authoritative = true;
+      candidate_ts = assist_response_time;
+    }
+  }
+  return out;
+}
