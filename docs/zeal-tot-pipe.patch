index 10499d1..253e929 100644
--- a/Zeal/assist_target.h
+++ b/Zeal/assist_target.h
@@ -41,6 +41,29 @@ class AssistTarget {
   // Poll interval in ms (clamped to [5000, 60000]).
   ZealSetting<int> setting_refresh_interval_ms = {10000, "AssistBar", "RefreshIntervalMs"};
 
+  // ── Consumer surface (named pipe) ─────────────────────────────────────────
+  // The candidate for `target_id`, resolved from the same two sources the bar
+  // draws from, without touching render or drag state. `defend` selects hit_by
+  // (who last hit the target) instead of victim_of (who the target last hit).
+  // `use_assist_reply` lets the OP_Assist answer compete: it answers "who is my
+  // target on", so a consumer asking who HIT the target passes false; the bar
+  // keeps its existing behaviour and lets it compete in both modes. id == 0
+  // means no fresh candidate. Cheap; safe to call every frame from the main loop.
+  struct Candidate {
+    WORD id = 0;
+    bool authoritative = false;  // The fresher source was the OP_Assist reply, not damage inference.
+  };
+  Candidate ResolveCandidate(WORD target_id, DWORD now, bool defend, bool use_assist_reply = true) const;
+
+  // The entity behind a candidate id, or nullptr when it is gone or a corpse —
+  // the same filter the bar applies before drawing.
+  static Zeal::GameStructures::Entity *LookupLiveEntity(WORD id);
+
+  // True when anything consumes this module's data: the bar, or a named-pipe
+  // client. The packet hooks stay idle when this is false, so a user who never
+  // enabled the bar pays nothing unless a pipe consumer is attached.
+  bool IsActive() const;
+
   // Internal callback use only.
   bool HandleLMouseUp(short x, short y);
 
