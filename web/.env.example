# Production URL — used for OG / canonical tags and the Discord OAuth callback.
# Vercel auto-sets VERCEL_URL on each deploy, but we want a stable value so we
# pin this here. Override in Preview environments if needed.
NEXT_PUBLIC_SITE_URL=https://wolfpack.quest

# Same Supabase project the Discord bot already uses. Anon key is safe to ship
# to the browser — RLS policies on the Supabase side control what's readable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only: needed for the OAuth callback to upsert wolfpack_members rows
# (bypasses RLS so a freshly-signed-in user's row can be written before any
# session-scoped policies apply). Find under Supabase Dashboard → Settings →
# API → service_role key. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Discord guild ID for the membership check on sign-in. The callback route
# calls Discord's API to confirm the signed-in user is in this guild before
# letting them through. Default matches the Wolf Pack EQ server.
DISCORD_GUILD_ID=1168893924329402420

# Comma-separated list of role names allowed to sign in to the site. The
# OAuth callback resolves the user's role IDs to names via the
# wolfpack_roles catalog (maintained by the bot) and rejects sign-in if
# none of the user's roles match. Must match the role NAMES (case-sensitive,
# whitespace-sensitive) as configured in Discord — same env var the bot
# uses to gate /kill, /announce, etc.
#
# Leave unset / empty to allow ANY guild member to sign in (membership-only
# gating still applies).
ALLOWED_ROLE_NAMES=Pack Member,Officer,Guild Leader

# The raid screen's live feed (/screen, /spectator). The page reads the BOT every 3 seconds instead of Vercel,
# with a ticket this site signs (GET /api/screen/ticket, once per viewer per ~2 hours). Both are server-only;
# enable them for Production AND Preview (b.wolfpack.quest is a Preview deployment), then redeploy.
#   SCREEN_TOKEN_SECRET  the SAME value the bot has (Railway). Never commit a real one.
#   SCREEN_LIVE_URL      the bot's full feed address: https://<the bot's public domain>/api/screen/live
#                        (https only; the ticket is sent there). The bot's SCREEN_ALLOWED_ORIGINS must
#                        include this site's origin (the default covers wolfpack.quest and b.wolfpack.quest).
# Either one unset = the pages poll Vercel's own routes exactly as before the bot feed existed.
SCREEN_TOKEN_SECRET=
SCREEN_LIVE_URL=

# Base URL for EQ item icons on the inventory page. The character inventory grid
# renders <base>/item_<icon>.png. Defaults to PQDI's icon path; override if you
# self-host the gequip icon set. A wrong/unreachable value degrades gracefully
# (the cell falls back to the item name) — it never shows broken images.
# NEXT_PUBLIC_EQ_ICON_BASE=https://www.pqdi.cc/Icons

# Discord OAuth client credentials are NOT needed here — they're configured
# directly in the Supabase Auth dashboard (Authentication → Sign In / Providers
# → Discord). These vars are documented for the case where we eventually
# move off Supabase Auth onto NextAuth.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# ── Guild kit (web/lib/guild.ts) ─────────────────────────────────────────────
# Every name below is OPTIONAL. Unset, the site is Wolf Pack's, exactly as it was before the kit. Resolution is
# always: environment variable, then the built-in default. Set them for another guild's deployment.
# The NEXT_PUBLIC_ ones are read in the browser as well; the rest are server-only. A value that must agree
# between server and browser belongs in the NEXT_PUBLIC_ name (that is why SUPABASE_GUILD_ID is only a
# server-side alias for the tag).
#
# NEXT_PUBLIC_GUILD_TAG=wolfpack          the guild_id every guild table is keyed on (alias: SUPABASE_GUILD_ID, server-only)
#                                         NEVER change it on a populated database: it orphans every row.
# NEXT_PUBLIC_GUILD_NAME=Wolf Pack        display name
# NEXT_PUBLIC_GUILD_SHORT=WP              short display name
# NEXT_PUBLIC_GUILD_INGAME_NAME=          the guild's name as the GAME spells it (killer_guild, /who). Defaults to GUILD_NAME.
# NEXT_PUBLIC_SITE_NAME=WolfPack.quest    site name
# NEXT_PUBLIC_BETA_SITE_URL=https://b.wolfpack.quest   the beta mirror's address (SITE_URL above wins when set)
# NEXT_PUBLIC_LOGIN_DOMAIN=login.wolfpack.quest   account key of every password account. FROZEN: leave it alone
#                                         on an existing deployment, changing it strands every password login.
# NEXT_PUBLIC_GITHUB_REPO=davehess/QuarmBossTracker   'owner/name' behind release and source links
# NEXT_PUBLIC_OPENDKP_BASE=https://wolfpack.opendkp.com   or NEXT_PUBLIC_OPENDKP_CLIENT=<client> for <client>.opendkp.com
# NEXT_PUBLIC_RAID_TZ=America/New_York    the raid schedule's time zone
#
# Server-only role gates (already documented above): ALLOWED_ROLE_NAMES (empty = gate off) and
# OFFICER_ROLE_NAMES (default "Officer,Pack Leader"). Both are read per request, not at import.
